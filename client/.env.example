# Copy this to .env (same folder as package.json) for local development.
# Points the frontend at your backend API.

# Local dev (while running `npm run dev` inside /server too):
VITE_API_URL=http://localhost:5000/api

# Once deployed, replace with your live backend URL, e.g.:
# VITE_API_URL=https://ledger-backend.onrender.com/api
