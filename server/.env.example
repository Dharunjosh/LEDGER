# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (from Atlas -> Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ledger?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
